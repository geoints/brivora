rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(ownerId) {
      return signedIn() && ownerId == request.auth.uid;
    }

    function ownsProject(projectId) {
      return signedIn()
        && exists(/databases/$(database)/documents/projects/$(projectId))
        && get(/databases/$(database)/documents/projects/$(projectId)).data.ownerId == request.auth.uid;
    }

    match /users/{userId} {
      allow read: if isOwner(userId);

      allow create: if isOwner(userId)
        && request.resource.data.keys().hasOnly([
          'firstName',
          'lastName',
          'role',
          'companyInfo',
          'avatarUrl',
          'updatedAt'
        ]);

      allow update: if isOwner(userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'firstName',
          'lastName',
          'role',
          'companyInfo',
          'avatarUrl',
          'updatedAt'
        ]);

      allow delete: if isOwner(userId);
    }

    match /projects/{projectId} {
      allow read: if isOwner(resource.data.ownerId);
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isOwner(resource.data.ownerId)
        && request.resource.data.ownerId == request.auth.uid;
      allow delete: if isOwner(resource.data.ownerId);
    }

    match /tasks/{taskId} {
      allow read: if ownsProject(resource.data.projectId);
      allow create: if ownsProject(request.resource.data.projectId);
      allow update: if ownsProject(resource.data.projectId)
        && request.resource.data.projectId == resource.data.projectId;
      allow delete: if ownsProject(resource.data.projectId);
    }

    match /estimates/{estimateId} {
      allow read: if isOwner(resource.data.ownerId);
      allow create: if signedIn() 
        && request.resource.data.ownerId == request.auth.uid
        && ownsProject(request.resource.data.projectId);
      allow update: if isOwner(resource.data.ownerId)
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.projectId == resource.data.projectId
        && ownsProject(resource.data.projectId);
      allow delete: if isOwner(resource.data.ownerId);
    }

    match /notes/{noteId} {
      allow read: if isOwner(resource.data.ownerId);
      allow create: if isOwner(request.resource.data.ownerId)
        && ownsProject(request.resource.data.projectId);
      allow update: if isOwner(resource.data.ownerId)
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.projectId == resource.data.projectId;
      allow delete: if isOwner(resource.data.ownerId);
    }

    match /photos/{photoId} {
      allow read: if isOwner(resource.data.ownerId);
      allow create: if isOwner(request.resource.data.ownerId)
        && ownsProject(request.resource.data.projectId);
      allow update: if isOwner(resource.data.ownerId)
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.projectId == resource.data.projectId;
      allow delete: if isOwner(resource.data.ownerId);
    }

    // Payment orders and subscription state are server-managed.
    // Clients must use authenticated callable Cloud Functions.
    match /paymentOrders/{orderId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
