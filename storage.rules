rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function ownsProject(projectId) {
      return signedIn()
        && firestore.get(/databases/(default)/documents/projects/$(projectId)).data.ownerId == request.auth.uid;
    }

    function isOwner(userId) {
      return signedIn() && userId == request.auth.uid;
    }

    function validImageUpload(maxBytes) {
      return request.resource != null
        && request.resource.size > 0
        && request.resource.size <= maxBytes
        && request.resource.contentType != null
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
    }

    match /users/{userId}/{allPaths=**} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId)
        && validImageUpload(5 * 1024 * 1024);
      allow delete: if isOwner(userId);
    }

    match /projects/{projectId}/photos/{fileName} {
      allow read: if ownsProject(projectId);
      allow write: if ownsProject(projectId)
        && validImageUpload(10 * 1024 * 1024);
      allow delete: if ownsProject(projectId);
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}