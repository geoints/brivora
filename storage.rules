rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function ownsProject(projectId) {
      return signedIn()
        && firestore.get(/databases/(default)/documents/projects/$(projectId)).data.ownerId == request.auth.uid;
    }

    match /users/{userId}/{allPaths=**} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId)
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');

      function isOwner(id) {
        return signedIn() && id == request.auth.uid;
      }
    }

    match /projects/{projectId}/photos/{fileName} {
      allow read: if ownsProject(projectId);
      allow write: if ownsProject(projectId)
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if ownsProject(projectId);
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
